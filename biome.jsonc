{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "**/*.{css,json,mjs,ts,tsx}",
      "!**/.turbo",
      "!**/.tmp",
      "!**/dist",
      "!**/node_modules",
      "!**/public"
    ]
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "recommended": true,
        "useButtonType": "error",
        "useSemanticElements": "off"
      },
      "complexity": {
        "recommended": true,
        "noForEach": "error",
        "noUselessContinue": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "useArrowFunction": "error",
        "useDateNow": "error",
        "useFlatMap": "error"
      },
      "correctness": {
        "recommended": true,
        "noUnsafeFinally": "error",
        "noUnusedFunctionParameters": "off",
        "useJsxKeyInIterable": "error"
      },
      "nursery": {
        "recommended": true,
        "noShadow": "error"
      },
      "performance": {
        "recommended": true,
        "noAccumulatingSpread": "off"
      },
      "security": {
        "recommended": true
      },
      "style": {
        "recommended": true,
        "noNonNullAssertion": "off",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useCollapsedElseIf": "error",
        "useConst": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "fix": "safe",
          "options": {
            "style": "type"
          }
        },
        "useExportType": "error",
        "useForOf": "error"
      },
      "suspicious": {
        "recommended": true,
        "noAlert": "error",
        "noNonNullAssertedOptionalChain": "off",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["debug", "error", "info", "time", "timeEnd", "warn"]
          }
        },
        "noDebugger": "error",
        "noExplicitAny": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", ":ALIAS:"],
              [":PATH:"],
              ":BLANK_LINE:",
              ["./*.css"]
            ]
          }
        }
      }
    }
  }
}
