{
  "extends": "@ts-boilerplates/tsconfig/react.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },
    "rootDir": ".",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.react.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
